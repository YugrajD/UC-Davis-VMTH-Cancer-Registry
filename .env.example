# Copy this file to .env and fill in your values
# cp .env.example .env
# NEVER commit .env to git — it contains secrets.

# ──────────────────────────────────────────────
# DATABASE  (REQUIRED — app will not start without these)
# ──────────────────────────────────────────────
# These values are placeholders only. Local dev now provisions Postgres via
# Floci's RDS emulation (see docker-compose.yml's `floci`/`floci-init`
# services and docs/floci-local-dev-migration.md) — floci-init.sh discovers
# the real RDS endpoint at container startup and overrides these for you.
# They're never actually read unless floci-init.sh hasn't run yet.
#
# In production this points at real RDS for PostgreSQL instead (see
# docs/aws-migration-plan.md).
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/postgres

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
# Allowed origins for the frontend. No changes needed for local development.
CORS_ORIGINS=["http://localhost:5173"]

# ──────────────────────────────────────────────
# AUTH — Amazon Cognito  (REQUIRED — app will not start without these)
# ──────────────────────────────────────────────
# Locally these are placeholders — floci-init.sh creates a real Cognito user
# pool + app client against Floci's Cognito emulation at container startup
# and overrides these (see docs/floci-local-dev-migration.md). No AWS
# account needed for local dev.
#
# In production these point at a real Cognito User Pool + App Client
# (COGNITO_ISSUER_URL becomes https://cognito-idp.{region}.amazonaws.com).
COGNITO_USER_POOL_ID=local_vmthdev
COGNITO_CLIENT_ID=vmthcancerregistryweb
COGNITO_ISSUER_URL=http://floci:4566

# Service-role key — grants FULL ADMIN ACCESS to your Supabase project.
# Used only for the "delete my account" feature (permanently removes the
# Supabase auth user via the Admin API). Keep this out of source control
# and out of the frontend entirely — backend env only.
# Supabase Dashboard → Settings → API → Project API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# ADMIN ACCOUNTS
# ──────────────────────────────────────────────
# Comma-separated list of email addresses that have admin privileges.
# Admin users can access the Review Queue and approve/reject uploads.
# These must match the email addresses used to sign up in Cognito.
ADMIN_EMAILS=admin@example.com

# ──────────────────────────────────────────────
# AUTH (Frontend) — Amazon Cognito
# ──────────────────────────────────────────────
# Same pool/client IDs as above, exposed to the browser bundle.
VITE_COGNITO_USER_POOL_ID=local_vmthdev
VITE_COGNITO_CLIENT_ID=vmthcancerregistryweb

# Browser-facing Cognito endpoint. Locally this is a relative path proxied
# by Vite (see frontend/vite.config.ts's '/cognito' rule) to Floci over the
# docker network — Floci doesn't support CORS on this endpoint, so calling
# it directly cross-origin from the browser fails; going through Vite's dev
# server keeps it same-origin instead. In production, leave blank — the AWS
# SDK resolves the real Cognito endpoint from COGNITO_USER_POOL_ID's region
# automatically.
VITE_COGNITO_ENDPOINT=/cognito

# Cognito Hosted UI domain for Google OAuth (e.g.
# https://your-domain.auth.us-east-1.amazoncognito.com). Leave blank to hide
# the "Continue with Google" button — Floci's Cognito emulation has no
# federation support, so this can't be exercised locally; configure it once
# a Hosted UI + Google OAuth client exist in the real Cognito User Pool.
VITE_COGNITO_GOOGLE_OAUTH_DOMAIN=

# Optional deployed FastAPI backend base URL for static frontend hosts like
# Amplify Hosting. Leave blank for local development, where Vite proxies
# /api to the backend container/process.
VITE_API_URL=

# ──────────────────────────────────────────────
# S3 STORAGE + ECS ML TASK
# ──────────────────────────────────────────────
# Uploaded CSVs, report text and model bundles live in S3. docker-compose
# points these at Floci by default; in AWS, the CDK stack sets them.
S3_BUCKET=vmth-cancer-registry-storage-local
AWS_REGION=us-east-1
# Leave empty in AWS. Floci: http://floci:4566
AWS_S3_ENDPOINT_URL=http://floci:4566
# Set USE_ECS_ML=true to run PetBERT inference as an on-demand Fargate task
# instead of the local ml-worker container. The CDK app stack outputs the
# cluster / task definition / subnet / security group values.
USE_ECS_ML=false
ECS_CLUSTER_ARN=
ML_TASK_DEFINITION_ARN=
ML_TASK_SUBNET_IDS=
ML_TASK_SECURITY_GROUP_ID=
ML_POLL_INTERVAL=60
ML_TIMEOUT_HOURS=12
ML_CLEANUP_JOB_FILES=false
CASE_PRESENCE_THRESHOLD=0.5
GROUP_CLASSIFIER_THRESHOLD=0.3
