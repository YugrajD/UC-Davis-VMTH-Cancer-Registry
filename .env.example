# Copy this file to .env and fill in your values
# cp .env.example .env
# NEVER commit .env to git — it contains secrets.

# ──────────────────────────────────────────────
# DATABASE  (REQUIRED — app will not start without these)
# ──────────────────────────────────────────────
# By default these point at the local `postgres` container defined in
# docker-compose.yml (PostGIS included) — no third-party account needed.
# The async URL uses the +asyncpg driver (for the FastAPI backend).
# The sync URL uses plain postgresql (for seed/ingestion scripts, and for
# running migrations).
#
# In production this points at RDS for PostgreSQL instead (see
# docs/aws-migration-plan.md).
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/postgres

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
# Allowed origins for the frontend. No changes needed for local development.
CORS_ORIGINS=["http://localhost:5173"]

# ──────────────────────────────────────────────
# AUTH — Amazon Cognito  (REQUIRED — app will not start without these)
# ──────────────────────────────────────────────
# Locally these point at cognito-local (a free, self-hosted Cognito
# emulator, see docker-compose.yml) with a fixed pool/client pre-seeded from
# database/docker/cognito-local/seed/ — no AWS account needed for local dev.
#
# In production these point at a real Cognito User Pool + App Client
# (COGNITO_ISSUER_URL becomes https://cognito-idp.{region}.amazonaws.com).
COGNITO_USER_POOL_ID=local_vmthdev
COGNITO_CLIENT_ID=vmthcancerregistryweb
COGNITO_ISSUER_URL=http://cognito-local:9229

# ──────────────────────────────────────────────
# ADMIN ACCOUNTS
# ──────────────────────────────────────────────
# Comma-separated list of email addresses that have admin privileges.
# Admin users can access the Review Queue and approve/reject uploads.
# These must match the email addresses used to sign up in Cognito.
ADMIN_EMAILS=admin@example.com

# ──────────────────────────────────────────────
# AUTH (Frontend) — Amazon Cognito
# ──────────────────────────────────────────────
# Same pool/client IDs as above, exposed to the browser bundle.
VITE_COGNITO_USER_POOL_ID=local_vmthdev
VITE_COGNITO_CLIENT_ID=vmthcancerregistryweb

# Browser-facing Cognito endpoint. Locally this is cognito-local's published
# port (must be reachable from the host, not the docker network hostname).
# In production, leave blank — the AWS SDK resolves the real Cognito
# endpoint from COGNITO_USER_POOL_ID's region automatically.
VITE_COGNITO_ENDPOINT=http://localhost:9229

# Cognito Hosted UI domain for Google OAuth (e.g.
# https://your-domain.auth.us-east-1.amazoncognito.com). Leave blank to hide
# the "Continue with Google" button — cognito-local has no federation
# support, so this can't be exercised locally; configure it once a Hosted UI
# + Google OAuth client exist in the real Cognito User Pool.
VITE_COGNITO_GOOGLE_OAUTH_DOMAIN=

# Optional deployed FastAPI backend base URL for static frontend hosts like
# Amplify Hosting. Leave blank for local development, where Vite proxies
# /api to the backend container/process.
VITE_API_URL=

# ──────────────────────────────────────────────
# GCP BATCH (Optional — for production ML inference)
# ──────────────────────────────────────────────
# Set USE_GCP_BATCH=true to route PetBERT inference through GCP Batch
# instead of the local ml-worker container. See docs/GCP_BATCH_SETUP.md.
USE_GCP_BATCH=false
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-gcs-bucket-name
GCP_BATCH_IMAGE_URI=us-central1-docker.pkg.dev/your-project/vmth/petbert-batch:latest
GCP_BATCH_MACHINE_TYPE=n1-standard-4
GCP_BATCH_POLL_INTERVAL=60
GCP_BATCH_TIMEOUT_HOURS=12
GCP_BATCH_CLEANUP_JOB_FILES=false
CASE_PRESENCE_THRESHOLD=0.5
GROUP_CLASSIFIER_THRESHOLD=0.3
# Place your service account key at secrets/gcp-sa-key.json
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-sa-key.json
